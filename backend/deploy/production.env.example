# 生产服务器环境文件模板。复制到 /etc/mtv/production.env 后填写真实值，
# 设置权限为 0600 或 0640；绝对不要将真实文件提交到 Git。
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=flowapp_session
SESSION_MAX_AGE=86400
CORS_ORIGINS=["https://app.example.com"]

# 单台服务器 Compose 会启动 postgres 与 redis 服务；应用容器应通过服务名访问，
# 不能填写 localhost、127.0.0.1 或宿主机映射端口。首次启动前请替换所有密码占位值。
MTV_POSTGRES_USER=mtv_app
MTV_POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
MTV_POSTGRES_DB=mtv
# 仅供 postgres 容器挂载；必须是 /opt 下的专属绝对目录，不能是 /。
MTV_POSTGRES_DATA_DIR=/opt/mtv/data/postgres

# 以下两个 URL 中的用户名、数据库名应与 MTV_POSTGRES_* 保持一致。
# 若密码含 @、:、/、# 等 URL 保留字符，必须填写 MTV_POSTGRES_PASSWORD 的 URL 编码值。
DATABASE_URL=postgresql+asyncpg://mtv_app:replace-url-encoded-postgres-password@postgres:5432/mtv
DATABASE_SYNC_URL=postgresql+psycopg2://mtv_app:replace-url-encoded-postgres-password@postgres:5432/mtv

# Redis 仅在 Compose 内部网络开放；仍必须设置强随机密码，禁止使用空密码。
MTV_REDIS_PASSWORD=replace-with-a-long-random-redis-password
# 仅供 redis 容器挂载；必须是 /opt 下的专属绝对目录，不能是 /。
MTV_REDIS_DATA_DIR=/opt/mtv/data/redis
# 若密码含 URL 保留字符，必须填写 MTV_REDIS_PASSWORD 的 URL 编码值。
REDIS_URL=redis://:replace-url-encoded-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-url-encoded-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-url-encoded-redis-password@redis:6379/2

# 生产默认使用阿里云 OSS；单机本地存储仅限一台服务器，须同时设置 STORAGE_DRIVER=local 和
# MTV_ALLOW_LOCAL_STORAGE=true，媒体会落到 MTV_LEGACY_STORAGE_HOST_PATH。
STORAGE_DRIVER=oss
# 仅 STORAGE_DRIVER=local 时允许设为 true；此开关是生产部署脚本的显式安全门禁。
MTV_ALLOW_LOCAL_STORAGE=false

# 阿里云 OSS 官方 V2 SDK。启用 OSS 时必须安装该可选依赖。
MTV_INSTALL_ALIYUN_OSS=true
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=mtv-production
ALIYUN_OSS_REGION=cn-hangzhou
# 仅在全部存量对象已按原 storage_key 同步到 OSS、非终态存储任务已排空，
# 且对象数、大小与抽样 SHA-256 已核验后改为 true。
ALIYUN_OSS_DATA_MIGRATION_CONFIRMED=false
# 生产 Bucket 必须关闭版本控制；true 授权部署脚本使用唯一临时 key 执行上传、
# 签名/匿名读取、Range、双并发防覆盖和删除 canary。
ALIYUN_OSS_CANARY_CONFIRMED=false

# 仅单机 STORAGE_DRIVER=local 时使用；API 与 worker 将以下宿主目录挂载到固定容器路径。
STORAGE_ROOT=/var/lib/mtv/storage
MTV_LEGACY_STORAGE_HOST_PATH=/opt/mtv/data/storage

# 按实际启用的 Provider 填写；完整说明见 docs/PROVIDERS.md。
TEXT_LLM_PROVIDER=openai
TEXT_LLM_API_KEY=replace-text-llm-key
TEXT_LLM_MODEL=gpt-4o
CHAT_LLM_PROVIDER=openai
CHAT_LLM_API_KEY=replace-chat-llm-key
CHAT_LLM_MODEL=gpt-4o
IMAGE_GEN_PROVIDER=bailian
IMAGE_GEN_API_KEY=replace-image-key
IMAGE_GEN_MODEL=qwen-image-2.0
VIDEO_PROVIDER_SELECTION_MODE=env
VIDEO_GEN_PROVIDER=volcengine
VIDEO_GEN_API_KEY=replace-video-key
VIDEO_GEN_MODEL=doubao-seedance-2-0-260128

# veImageX 参考图审核。PUBLIC_BASE_URL 是部署后 API 的公网 HTTPS origin，
# 不能填 localhost；本地媒体仅通过限时鉴权代理提供给审核服务。
VOLC_IMAGE_AUDIT_ENABLED=true
VOLC_IMAGEX_ACCESS_KEY=replace-volc-imagex-access-key
VOLC_IMAGEX_SECRET_KEY=replace-volc-imagex-secret-key
VOLC_IMAGEX_SERVICE_ID=replace-volc-imagex-service-id
VOLC_IMAGE_AUDIT_PUBLIC_BASE_URL=https://api.example.com
