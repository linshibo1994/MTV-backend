# 生产服务器环境文件模板。复制到 /etc/mtv/production.env 后填写真实值，
# 设置权限为 0600 或 0640；绝对不要将真实文件提交到 Git。
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=flowapp_session
SESSION_MAX_AGE=86400
CORS_ORIGINS=["https://app.example.com"]

DATABASE_URL=postgresql+asyncpg://mtv_app:replace-url-encoded-password@postgres.example.internal:5432/mtv
DATABASE_SYNC_URL=postgresql+psycopg2://mtv_app:replace-url-encoded-password@postgres.example.internal:5432/mtv
REDIS_URL=rediss://:replace-redis-password@redis.example.internal:6379/0
CELERY_BROKER_URL=rediss://:replace-redis-password@redis.example.internal:6379/1
CELERY_RESULT_BACKEND=rediss://:replace-redis-password@redis.example.internal:6379/2

# 生产必须显式选择 s3 或 meizi；MeiZi 须先通过真实上传、读取、删除验收。
# 保留占位值会被部署脚本拒绝，避免复制模板后误启用尚未验收的存储后端。
STORAGE_DRIVER=replace-with-s3-or-meizi
# 仅 STORAGE_DRIVER=s3 时改为 true，以便生产镜像安装 boto3。
MTV_INSTALL_S3=false
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mtv-production
S3_REGION=us-east-1

MEIZI_BASE_URL=https://mc.tmuyun.com/endpoint
# 默认 false；只有服务器仍挂载旧 STORAGE_ROOT 时，灰度切换期才设为 true。
# 开启后也只有无远端映射的历史对象走本地，新写入始终只进入 MeiZi。
MEIZI_LEGACY_LOCAL_FALLBACK=false
# fallback=true 时，API 与 worker 把同一宿主目录挂载到以下固定容器路径。
# 宿主目录必须预先存在、可读写，且不得配置为 /。
STORAGE_ROOT=/var/lib/mtv/storage
MTV_LEGACY_STORAGE_HOST_PATH=/var/lib/mtv/storage
MEIZI_UPLOAD_USER_NAME=replace-meizi-user-name
MEIZI_UPLOAD_TENANT_ID=replace-positive-tenant-id
MEIZI_UPLOAD_GROUP_ID=replace-positive-group-id
MEIZI_UPLOAD_SOURCE=replace-positive-source
# Java 参考实现硬编码该盐；Python 生产环境必须由密钥管理注入，当前与 FRONT_SALT 同值。
MEIZI_UPLOAD_SALT=replace-meizi-upload-signing-salt
MEIZI_FRONT_USER_NAME=
MEIZI_FRONT_TENANT_ID=replace-positive-tenant-id
MEIZI_FRONT_GROUP_ID=0
MEIZI_FRONT_SOURCE=replace-positive-source
MEIZI_FRONT_SALT=replace-meizi-front-signing-salt
MEIZI_LIB_TYPE_FILE=704
MEIZI_LIB_TYPE_IMAGE=703
MEIZI_LIB_TYPE_VIDEO=701
MEIZI_LIB_TYPE_AUDIO=702
MEIZI_UPLOAD_ALLOWED_HOSTS=[]
MEIZI_PUBLIC_URL_ALLOWED_HOSTS=[]
MEIZI_CLEANUP_STALE_SECONDS=3600
MEIZI_CLEANUP_BATCH_SIZE=20
# true 表示授权部署脚本在迁移后执行真实 upload -> HTTPS read -> shiftDelete canary；
# canary 任一步失败都会阻止 API/worker 启动，不是可长期跳过检查的历史确认值。
MEIZI_DELETE_CANARY_CONFIRMED=false

# 按实际启用的 Provider 填写；完整说明见 docs/PROVIDERS.md。
TEXT_LLM_PROVIDER=openai
TEXT_LLM_API_KEY=replace-text-llm-key
TEXT_LLM_MODEL=gpt-4o
CHAT_LLM_PROVIDER=openai
CHAT_LLM_API_KEY=replace-chat-llm-key
CHAT_LLM_MODEL=gpt-4o
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_API_KEY=replace-image-key
IMAGE_GEN_MODEL=gpt-image-2
VIDEO_PROVIDER_SELECTION_MODE=env
VIDEO_GEN_PROVIDER=volcengine
VIDEO_GEN_API_KEY=replace-video-key
VIDEO_GEN_MODEL=doubao-seedance-2-0-260128

# veImageX 参考图审核。PUBLIC_BASE_URL 是部署后 API 的公网 HTTPS origin，
# 不能填 localhost；MeiZi 原始永久公共 URL不会直接发送给第三方。
VOLC_IMAGE_AUDIT_ENABLED=true
VOLC_IMAGEX_ACCESS_KEY=replace-volc-imagex-access-key
VOLC_IMAGEX_SECRET_KEY=replace-volc-imagex-secret-key
VOLC_IMAGEX_SERVICE_ID=replace-volc-imagex-service-id
VOLC_IMAGE_AUDIT_PUBLIC_BASE_URL=https://api.example.com
