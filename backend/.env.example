# ===== 应用配置 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 跨域（本地开发允许任意来源；通配符模式不携带 Cookie 凭据） =====
CORS_ORIGINS=["*"]

# ===== 数据库 / 缓存 =====
DATABASE_URL=postgresql+asyncpg://flow:flow@localhost:55432/flowapp
DATABASE_SYNC_URL=postgresql+psycopg2://flow:flow@localhost:55432/flowapp
REDIS_URL=redis://localhost:56379/0
CELERY_BROKER_URL=redis://localhost:56379/1
CELERY_RESULT_BACKEND=redis://localhost:56379/2

# ===== 会话 / 鉴权 =====
SESSION_SECRET=change-me-to-a-long-random-string-in-prod
SESSION_COOKIE_NAME=flowapp_session
SESSION_MAX_AGE=86400
TGW_L7_ROUTE_COOKIE=flowapp-tgw

# ===== 媒体存储（仅支持 local 或 oss） =====
STORAGE_DRIVER=local
STORAGE_ROOT=./storage

# 阿里云 OSS 直连（STORAGE_DRIVER=oss）。Region 必须与公网 Endpoint 匹配。
ALIYUN_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=flowapp
ALIYUN_OSS_REGION=cn-hangzhou

# ===== AI 供应商 (真实接入) =====
# 说明：请求级动态路由 — 前端每次请求可显式传入 provider+model（如 bailian +
# qwen-max），后端按请求路由到对应厂商；模型优先级为显式请求模型 > 厂商
# .env 保底模型 > 代码内置兜底。厂商凭证使用下方各厂商专属字段。
# 旧字段（OPENAI_API_KEY / GOOGLE_API_KEY / VOLCENGINE_*）保留，作为能力级
# 未显式配置时的兼容回退。

# --- 旧厂商字段（兼容回退，可只填下面、上面新配置留空） ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
# 火山云账号 AK/SK（已废弃，视频改用 VOLCENGINE_API_KEY）
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-260128
VIDEO_DEFAULT_PROVIDER=modelsai

# --- 文本 LLM（结构化单轮，pipeline split/extract/merge/enrich/parents 用） ---
# 服务端默认链：未按请求显式路由时使用；显式配置 BASE_URL/API_KEY/MODEL
# 生效，否则回退厂商专属字段（DASHSCOPE_/DEEPSEEK_/NEOLINK_/...）。
#   openai   https://api.openai.com/v1
#   deepseek https://api.deepseek.com
#   bailian  https://dashscope.aliyuncs.com/compatible-mode/v1
#   gemini   https://generativelanguage.googleapis.com/v1beta/openai/
#   neolink  https://neolink.com/api/v1（NEOLINK_BASE_URL 可填 /api 或 /api/v1）
TEXT_LLM_BASE_URL=
TEXT_LLM_API_KEY=
TEXT_LLM_MODEL=
# 自定义 OpenAI 兼容厂商：请求显式 provider=openai_compatible，并填写其 BASE_URL/API_KEY/MODEL。

# --- 对话 LLM（多轮对话 / 新闻播报） ---
# 语义同上；NeoLink 文本/对话中，能力级 API_KEY、BASE_URL 的显式值优先；
# 两者留空时才回退 NEOLINK_API_KEY、NEOLINK_BASE_URL。
# 不复用 IMAGE_GEN_MODEL；NeoLink 文本/对话 MODEL 留空时默认 qwen-turbo，生产应以
# GET https://neolink.com/api/v1/models 返回的模型 ID 显式覆盖（例如 qwen-turbo）。
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=

# --- 图片生成 (openai | gemini | bailian | neolink) ---
# neolink 走 OpenAI 兼容 /v1/images/generations，模型 gp-im-2（恒返回 b64_json）；
# 留空 IMAGE_GEN_API_KEY / IMAGE_GEN_BASE_URL 时自动回退 NEOLINK_API_KEY / NEOLINK_BASE_URL。
# qwen-turbo 是纯文本/对话模型，不能用于参考图画风等多模态提取；此类图片能力仍用 gp-im-2。
# 请求显式传入 model 时，IMAGE_GEN_MODEL 覆盖不再生效（不覆盖请求级模型选择）。
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=

# --- 视频生成 (volcengine | neolink | bailian | openai | gemini | mgrouter) ---
# env：由以下变量选择（服务端默认）；database：保留后台 active provider 动态切换。
# 请求显式传入 provider/model 时优先于两者。
# 切换到 MGRouter 时将 BASE_URL/API_KEY/MODEL 置空，使其回退到 MGROUTER_* 独立配置；
# 或直接填写 MGRouter 的通用四元组。
VIDEO_PROVIDER_SELECTION_MODE=env
VIDEO_GEN_BASE_URL=
VIDEO_GEN_API_KEY=
VIDEO_GEN_MODEL=

# --- 国内厂商独立 Key ---
# 火山方舟 Ark（Seedance 2.0 视频生成；provider=volcengine 时用，Bearer Token 鉴权）
VOLCENGINE_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# NeoLink（provider=neolink；视频复用 SEEDANCE_MODEL；文本/对话走 OpenAI Chat Completions）
# 可填 https://neolink.com/api 或 https://neolink.com/api/v1；文本最终请求 /api/v1/chat/completions。
NEOLINK_BASE_URL=https://neolink.com/api
NEOLINK_API_KEY=
# MGRouter AICC Seedance（provider=mgrouter；使用火山内容生成兼容协议）
MGROUTER_API_KEY=
MGROUTER_BASE_URL=https://mgrouter.com/api/v3
MGROUTER_VIDEO_MODEL=AICC-Doubao-Seedance-2.0
MGROUTER_RESOLUTION=720p
MGROUTER_RATIO=adaptive
MGROUTER_GENERATE_AUDIO=true
MGROUTER_WATERMARK=false
# veImageX 单图审核（视频参考图在提交 Seedance 前必须审核）。使用独立 AK/SK，
# 不能填 Ark API Key 或旧 VOLCENGINE_ACCESS_KEY/SECRET_KEY。OSS 可直接使用短期
# 预签名 URL；local 必须通过下方 HMAC 限时图片代理。
VOLC_IMAGE_AUDIT_ENABLED=true
VOLC_IMAGEX_ACCESS_KEY=
VOLC_IMAGEX_SECRET_KEY=
VOLC_IMAGEX_SERVICE_ID=
# 部署后 API 的公网 HTTPS origin（例如 https://api.example.com），不能填 localhost、
# 内网地址、路径、query 或 fragment；本地无法被 veImageX 拉取时保持为空并 fail closed。
VOLC_IMAGE_AUDIT_PUBLIC_BASE_URL=
# 阿里百炼 DashScope（LLM qwen + 文生图通义万相 + 视频通义万相共用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DeepSeek（provider=deepseek 时用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 国外厂商独立 Key ---
# Anthropic Claude（provider=claude 时用；非 OpenAI 兼容，原生 Messages API）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
# Google Gemini（文本/对话走 OpenAI 兼容端点；图片与 Veo 视频也可复用）
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# ===== 积分定价 =====
PRICE_EXTRACT_PER_EPISODE=10
PRICE_MERGE=20
PRICE_ENRICH_PER_SUBJECT=5
PRICE_IMAGE_GEN=30
PRICE_STORYBOARD_PER_EPISODE=50
PRICE_VIDEO_GEN=900
PRICE_VIDEO_GEN_FROZEN=210

# ===== 媒体代理 =====
MEDIA_PROXY_PREFIX=/api/x/cctv/zhihui/flow-app
