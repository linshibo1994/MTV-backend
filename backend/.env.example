# ===== 应用配置 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 跨域（本地开发允许任意来源；通配符模式不携带 Cookie 凭据） =====
CORS_ORIGINS=["*"]

# ===== 数据库 / 缓存 =====
DATABASE_URL=postgresql+asyncpg://flow:flow@localhost:55432/flowapp
DATABASE_SYNC_URL=postgresql+psycopg2://flow:flow@localhost:55432/flowapp
REDIS_URL=redis://localhost:56379/0
CELERY_BROKER_URL=redis://localhost:56379/1
CELERY_RESULT_BACKEND=redis://localhost:56379/2

# ===== 会话 / 鉴权 =====
SESSION_SECRET=change-me-to-a-long-random-string-in-prod
SESSION_COOKIE_NAME=flowapp_session
SESSION_MAX_AGE=86400
TGW_L7_ROUTE_COOKIE=flowapp-tgw

# ===== 对象存储 =====
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=flowapp
S3_REGION=us-east-1

# 公司 MeiZi 公共媒资中心（STORAGE_DRIVER=meizi 时启用）。
# 服务端只持有接口签名盐；公共 OSS 的 AK/SK 由 uploadToken 临时签发，不配置在本项目。
MEIZI_BASE_URL=https://mc.tmuyun.com/endpoint
# 切换期建议 true：仅无 MeiZi 映射的历史对象从 STORAGE_ROOT 读取/删除；
# 新写入始终进入 MeiZi。历史对象清空后改为 false。
MEIZI_LEGACY_LOCAL_FALLBACK=false
MEIZI_UPLOAD_USER_NAME=
MEIZI_UPLOAD_TENANT_ID=0
MEIZI_UPLOAD_GROUP_ID=0
MEIZI_UPLOAD_SOURCE=0
# Java 参考实现把上传盐硬编码在 TokenRequest；Python 禁止硬编码，需在此注入。
# 当前 MeiZi 配置中它与 MEIZI_FRONT_SALT 使用同一值。
MEIZI_UPLOAD_SALT=
MEIZI_FRONT_USER_NAME=
MEIZI_FRONT_TENANT_ID=0
# groupId=0 表示根目录，是合法值。
MEIZI_FRONT_GROUP_ID=0
MEIZI_FRONT_SOURCE=0
MEIZI_FRONT_SALT=
MEIZI_LIB_TYPE_FILE=704
MEIZI_LIB_TYPE_IMAGE=703
MEIZI_LIB_TYPE_VIDEO=701
MEIZI_LIB_TYPE_AUDIO=702
# 可选的精确主机白名单，留空时仍会执行 HTTPS、公网 DNS/IP、禁重定向校验。
MEIZI_UPLOAD_ALLOWED_HOSTS=[]
MEIZI_PUBLIC_URL_ALLOWED_HOSTS=[]
MEIZI_CONNECT_TIMEOUT_SECONDS=30
MEIZI_READ_TIMEOUT_SECONDS=600
MEIZI_WRITE_TIMEOUT_SECONDS=600
MEIZI_PROCESSING_POLL_ATTEMPTS=10
MEIZI_PROCESSING_POLL_INTERVAL_SECONDS=2
# 中断上传/删除失败对象静默超过该秒数后，由 Celery Beat 定期重试远端删除。
MEIZI_CLEANUP_STALE_SECONDS=3600
MEIZI_CLEANUP_BATCH_SIZE=20

# ===== AI 供应商 (真实接入) =====
# 说明：能力×厂商适配，每个能力独立配置厂商 URL+Key，切换厂商改 *_PROVIDER 即可。
# 旧字段（OPENAI_API_KEY / GOOGLE_API_KEY / VOLCENGINE_*）保留，新字段为空时自动回退。

# --- 旧厂商字段（兼容回退，可只填下面、上面新配置留空） ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
# 火山云账号 AK/SK（已废弃，视频改用 VOLCENGINE_API_KEY）
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-260128
VIDEO_DEFAULT_PROVIDER=modelsai

# --- 文本 LLM（结构化单轮，pipeline split/extract/merge/enrich/parents 用） ---
# provider 可选：openai | deepseek | bailian | anthropic(claude) | gemini | openai_compatible
# base_url 留空则用 provider 内置默认：
#   openai   https://api.openai.com/v1
#   deepseek https://api.deepseek.com
#   bailian  https://dashscope.aliyuncs.com/compatible-mode/v1
#   gemini   https://generativelanguage.googleapis.com/v1beta/openai/
TEXT_LLM_PROVIDER=openai
TEXT_LLM_BASE_URL=
TEXT_LLM_API_KEY=
TEXT_LLM_MODEL=
# 自定义 OpenAI 兼容厂商示例：provider=openai_compatible，并填写其 BASE_URL/API_KEY/MODEL。

# --- 对话 LLM（多轮对话 / 新闻播报） ---
CHAT_LLM_PROVIDER=openai
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=

# --- 图片生成 (provider: openai | gemini | bailian) ---
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=

# --- 视频生成 (provider: volcengine | bailian | openai | gemini；google/veo 规范化为 gemini) ---
# 各视频厂商都优先使用以下通用 URL+Key；留空时回退到厂商独立配置。
# env：由以下变量选择；database：保留后台 active provider 动态切换。
VIDEO_PROVIDER_SELECTION_MODE=env
VIDEO_GEN_PROVIDER=volcengine
VIDEO_GEN_BASE_URL=
VIDEO_GEN_API_KEY=
VIDEO_GEN_MODEL=

# --- 国内厂商独立 Key ---
# 火山方舟 Ark（Seedance 2.0 视频生成；provider=volcengine 时用，Bearer Token 鉴权）
VOLCENGINE_API_KEY=
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# veImageX 单图审核（视频参考图在提交 Seedance 前必须审核）。使用独立 AK/SK，
# 不能填 Ark API Key 或旧 VOLCENGINE_ACCESS_KEY/SECRET_KEY。S3 可直接使用短期
# 预签名 URL；MeiZi/local 必须通过下方 HMAC 限时图片代理，禁止发送永久公共 URL。
VOLC_IMAGE_AUDIT_ENABLED=true
VOLC_IMAGEX_ACCESS_KEY=
VOLC_IMAGEX_SECRET_KEY=
VOLC_IMAGEX_SERVICE_ID=
# 部署后 API 的公网 HTTPS origin（例如 https://api.example.com），不能填 localhost、
# 内网地址、路径、query 或 fragment；本地无法被 veImageX 拉取时保持为空并 fail closed。
VOLC_IMAGE_AUDIT_PUBLIC_BASE_URL=
# 阿里百炼 DashScope（LLM qwen + 文生图通义万相 + 视频通义万相共用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DeepSeek（provider=deepseek 时用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 国外厂商独立 Key ---
# Anthropic Claude（provider=claude 时用；非 OpenAI 兼容，原生 Messages API）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
# Google Gemini（文本/对话走 OpenAI 兼容端点；图片与 Veo 视频也可复用）
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# ===== 积分定价 =====
PRICE_EXTRACT_PER_EPISODE=10
PRICE_MERGE=20
PRICE_ENRICH_PER_SUBJECT=5
PRICE_IMAGE_GEN=30
PRICE_STORYBOARD_PER_EPISODE=50
PRICE_VIDEO_GEN=900
PRICE_VIDEO_GEN_FROZEN=210

# ===== 媒体代理 =====
MEDIA_PROXY_PREFIX=/api/x/cctv/zhihui/flow-app
