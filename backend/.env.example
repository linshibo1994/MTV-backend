# ===== 应用配置 =====
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ===== 数据库 / 缓存 =====
DATABASE_URL=postgresql+asyncpg://flow:flow@localhost:5432/flowapp
DATABASE_SYNC_URL=postgresql+psycopg2://flow:flow@localhost:5432/flowapp
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== 会话 / 鉴权 =====
SESSION_SECRET=change-me-to-a-long-random-string-in-prod
SESSION_COOKIE_NAME=flowapp_session
SESSION_MAX_AGE=86400
TGW_L7_ROUTE_COOKIE=flowapp-tgw

# ===== 对象存储 =====
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=flowapp
S3_REGION=us-east-1

# ===== AI 供应商 (真实接入) =====
# 说明：能力×厂商适配，每个能力独立配置厂商 URL+Key，切换厂商改 *_PROVIDER 即可。
# 旧字段（OPENAI_API_KEY / GOOGLE_API_KEY / VOLCENGINE_*）保留，新字段为空时自动回退。

# --- 旧厂商字段（兼容回退，可只填下面、上面新配置留空） ---
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-2.5-flash-image
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0-260128
VIDEO_DEFAULT_PROVIDER=modelsai

# --- 文本 LLM（结构化单轮，pipeline split/extract/merge/enrich/parents 用） ---
# provider 可选：openai | deepseek | bailian | claude | gemini
# base_url 留空则用 provider 内置默认：
#   openai   https://api.openai.com/v1
#   deepseek https://api.deepseek.com
#   bailian  https://dashscope.aliyuncs.com/compatible-mode/v1
#   gemini   https://generativelanguage.googleapis.com/v1beta/openai/
TEXT_LLM_PROVIDER=openai
TEXT_LLM_BASE_URL=
TEXT_LLM_API_KEY=
TEXT_LLM_MODEL=gpt-4o

# --- 对话 LLM（多轮对话 / 新闻播报） ---
CHAT_LLM_PROVIDER=openai
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=gpt-4o

# --- 图片生成 (provider: openai | google | bailian) ---
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_BASE_URL=
IMAGE_GEN_API_KEY=
IMAGE_GEN_MODEL=gpt-image-2

# --- 视频生成 (provider: volcengine | bailian | openai) ---
VIDEO_GEN_PROVIDER=volcengine
VIDEO_GEN_MODEL=doubao-seedance-2-0-260128

# --- 国内厂商独立 Key ---
# 阿里百炼 DashScope（LLM qwen + 文生图通义万相 + 视频通义万相共用）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
# DeepSeek（provider=deepseek 时用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 国外厂商独立 Key ---
# Anthropic Claude（provider=claude 时用；非 OpenAI 兼容，原生 Messages API）
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5
# Google Gemini（LLM 走 OpenAI 兼容端点时用；图片仍用 GOOGLE_API_KEY）
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash

# ===== 积分定价 =====
PRICE_EXTRACT_PER_EPISODE=10
PRICE_MERGE=20
PRICE_ENRICH_PER_SUBJECT=5
PRICE_IMAGE_GEN=30
PRICE_STORYBOARD_PER_EPISODE=50
PRICE_VIDEO_GEN=900
PRICE_VIDEO_GEN_FROZEN=210

# ===== 媒体代理 =====
MEDIA_PROXY_PREFIX=/api/x/cctv/zhihui/flow-app
