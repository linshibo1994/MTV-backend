# 复制为 scripts/deploy.env 后填写（推荐），或复制到项目根目录 .deploy.env：
#   cp scripts/deploy.env.example scripts/deploy.env
#
# 含密码时请勿提交到 Git（scripts/deploy.env / .deploy.env 均已在 .gitignore）。
# 服务器上的应用配置默认位于 /data/users/lsbo/MTV/mtv-api/backend/.env。
# 首次部署仅在服务器 .env 不存在时从本地 backend/.env 生成容器化生产配置；
# 服务器已有 .env 时 deploy 绝不自动覆盖，需明确执行 sync-env 或设 DEPLOY_SYNC_ENV=always。

# 服务器
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PASSWORD=

# 远端项目目录（代码会同步到此目录/backend）
DEPLOY_PATH=/data/users/lsbo/MTV/mtv-api
REMOTE_ENV_FILE=/data/users/lsbo/MTV/mtv-api/backend/.env

# 生产 Compose 和镜像
MTV_PRODUCTION_PROJECT_NAME=mtv-production
MTV_PRODUCTION_IMAGE=mtv-backend:production
MTV_POSTGRES_IMAGE=postgres:16-alpine
MTV_REDIS_IMAGE=redis:7-alpine
MTV_INSTALL_ALIYUN_OSS=true
DEPLOY_TARGET_PLATFORM=linux/amd64

# 默认同时上传 PostgreSQL/Redis 依赖镜像归档，确保新服务器无需在线拉取镜像。
# 若服务器已确认存在完全匹配的镜像，可改为 false。
DEPLOY_PUSH_DEPENDENCY_IMAGES=true

# deploy 默认执行 Alembic 迁移；如需仅更新镜像，可显式改为 false。
DEPLOY_RUN_MIGRATIONS=true
DEPLOY_ALLOW_DATABASE_MIGRATION=true

# 环境文件同步：auto 仅在服务器 .env 缺失时生成；always 每次 deploy 生成；never 永不生成。
# sync-env/always 会完整替换服务器 .env，请先备份并确认数据库连接与密钥不会变化。
DEPLOY_SYNC_ENV=auto

# 安全默认：仅本机监听且不开放跨域。独立前端直连时填写准确 Origin 与 0.0.0.0；
# 公网生产应优先使用 HTTPS 反向代理，而不是直接暴露 API 端口。
MTV_PRODUCTION_CORS_ORIGINS=[]
MTV_PRODUCTION_API_BIND_ADDRESS=127.0.0.1
DEPLOY_ALLOW_INSECURE_HTTP_SESSION=false

# 默认不创建管理员。仅首次私有环境初始化时明确设为 true，
# 并填写唯一用户名和强随机密码；既有账号不会被改密或提权。
DEPLOY_BOOTSTRAP_ADMIN=false
DEPLOY_BOOTSTRAP_ADMIN_USERNAME=
DEPLOY_BOOTSTRAP_ADMIN_PASSWORD=
DEPLOY_BOOTSTRAP_ADMIN_CREDITS=1000000
MTV_LOG_TAIL=200
